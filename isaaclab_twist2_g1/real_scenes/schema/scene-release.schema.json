{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanoid-arena.local/schemas/scene-release.schema.json",
  "title": "HumanoidArena Real-Scene Release Lock",
  "type": "object",
  "required": ["schema_version", "scene_id", "source_revisions", "artifacts", "control_files", "distribution"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "source_revisions": {
      "type": "object",
      "required": ["humanoid_arena_commit", "three_d_grut_commit"]
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    },
    "control_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    },
    "distribution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["server-local", "huggingface"]},
        "repository": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "required": {"type": "boolean"}
      }
    }
  }
}
